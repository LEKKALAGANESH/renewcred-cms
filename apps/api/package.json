{
  "name": "@renewcred/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run --passWithNoTests",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.1.0",
    "@renewcred/env": "0.1.0",
    "@renewcred/logger": "0.1.0",
    "@renewcred/schema": "0.1.0",
    "bcryptjs": "2.4.3",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "dotenv-cli": "^11.0.0",
    "prisma": "6.1.0",
    "tsx": "^4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
