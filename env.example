# Copy to .env and fill in:  cp env.example .env
# Never commit .env — see .gitignore.
#
# Every variable here is validated at boot by @renewcred/env. A missing or
# placeholder value crashes the process rather than falling back to a default —
# a fallback secret is a publicly-known signing key waiting to happen.

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── Database (Supabase) ──────────────────────────────────────────────────
# BOTH URLs must carry ?schema=renewcred. The CMS owns a dedicated Postgres
# schema so migrations, resets, and RLS grants cannot reach anything in public.
# Without it Prisma targets public and `migrate dev` reads every foreign table
# as drift — then offers to reset it. See ADR-0004.
#
# PASSWORD must be percent-encoded. A literal @ : / ? # or % in the password
# splits the URI at the wrong delimiter, so the driver resolves a bogus host and
# reports "P1001 Can't reach database server" — an error that looks like the
# database is down when the credentials are simply unparseable. Encode @ as %40.
#
# Pooled — Supavisor TRANSACTION mode, port 6543. Used by the running app.
# pgbouncer=true is required: transaction pooling cannot carry prepared statements.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=renewcred"

# Direct — SESSION mode, port 5432. Used by `prisma migrate` only.
# Some networks intercept port 5432; if this times out while 6543 works, see
# docs/DATA_WORKFLOW.md for applying migrations via the Supabase control plane.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=renewcred"

# ── Supabase (server-side only) ──────────────────────────────────────────
SUPABASE_URL=https://PROJECT_REF.supabase.co
# NEVER expose this to a browser. Not in NEXT_PUBLIC_*, not in the admin bundle,
# not in any Vite VITE_* variable. It bypasses RLS entirely — treat it exactly
# like a database superuser password.
SUPABASE_SERVICE_ROLE_KEY=changeme
SUPABASE_STORAGE_BUCKET=assets

# There is deliberately NO publishable/anon key here either.
# Express is the only Supabase client (ADR-0002, ADR-0004). The bucket is
# PRIVATE and the API hands out short-lived signed URLs, so no browser ever
# authenticates to Supabase — not even with a restricted key. The safest
# browser credential is the one that does not exist.

# ── Auth ─────────────────────────────────────────────────────────────────
# Signs ACCESS tokens only. Minimum 32 chars.
# Generate with:  openssl rand -base64 48
JWT_SECRET=changeme-must-be-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# There is deliberately NO JWT_REFRESH_SECRET.
# Refresh tokens are opaque random strings stored HASHED in the sessions table,
# not JWTs — so there is nothing to sign. A signed refresh JWT is self-validating
# and therefore cannot be revoked before expiry, which means logout does not
# actually log the user out. A DB-backed opaque token buys instant revocation,
# rotation, and reuse detection (a replayed token means theft — revoke the whole
# session family). See ADR-0005.

# ── API ──────────────────────────────────────────────────────────────────
# Named PORT, not API_PORT: hosting platforms inject PORT and the app must obey it.
PORT=4000
# Explicit allowlist. Never "*" on authenticated endpoints.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# ── Frontends ────────────────────────────────────────────────────────────
# Public base URL of the Express API. Safe to expose — it is only an origin.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
VITE_API_URL=http://localhost:4000/api/v1
