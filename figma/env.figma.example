# Copy this file to figma/.env.figma.local and fill in real values.
# .env.figma.local must never be committed — add it to .gitignore.

# Figma -> avatar -> Settings -> Security -> Personal access tokens.
# Needs the "File content: Read" scope. Shown once at creation.
FIGMA_TOKEN=figd_your_token_here

# From your file's URL: figma.com/design/<FILE_KEY>/<name>
# Use YOUR copy's key — copying the file mints a new one.
FIGMA_FILE_KEY=xxxxxxxxxxxxxxxxxxxxxx
